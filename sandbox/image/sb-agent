#!/bin/sh
# Keeps the guest in step with the editor without anyone running `sb sync`.
# inittab starts it at boot, so it is already running in the snapshot.
#
# The page sends a newline on ttyS2 after staging saves in /.sb, and this
# applies them through the kernel (see sb) and answers "applied". Nothing runs
# between saves: it waits in read, so it adds nothing to a run's count.
#
# A serial line can't carry a terminal's size, so the page also sends
# "size PORT ROWS COLS" whenever it resizes the terminal on ttyS<PORT>. Setting
# it here is the same ioctl a terminal emulator makes on a pseudo-terminal, so
# the program in front gets SIGWINCH, and anything that asks for the size
# gets the new one.
#
# "close PORT" hangs up the terminal on ttyS<PORT> when the page closes it, as
# closing a terminal tab does: its shell and whatever runs in it get SIGHUP,
# and inittab starts a fresh login there for the next time it opens.
#
# The other way needs nothing in here: the page sees the guest's writes as
# they reach v86's 9p server. Files are written back when closed; the shorter
# writeback delay covers programs that keep a file open.
# init's PATH has no /usr/local/bin, where sb is
export PATH="/usr/local/bin:$PATH"
sysctl -q -w vm.dirty_expire_centisecs=100 vm.dirty_writeback_centisecs=100

stty -F /dev/ttyS2 raw -echo
exec < /dev/ttyS2 > /dev/ttyS2 2>&1
while read -r cmd port rows cols; do
  case "$cmd $port" in
    "size 0" | "size 1") stty -F "/dev/ttyS$port" rows "$rows" cols "$cols" 2>/dev/null ;;
    "close 0" | "close 1") fuser -k -HUP "/dev/ttyS$port" > /dev/null 2>&1 ;;
    *)
      sb apply
      echo applied
      ;;
  esac
done
