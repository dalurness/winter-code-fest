---
import { dayToDate, yyyymmdd } from "../schedule";

interface Props {
  day: number;
  title: string;
}

const { day, title } = Astro.props;
const date = dayToDate(day);
---

<h1>
  Day {day}: {title}
</h1>
<time
  datetime={yyyymmdd(date)}
  class="block -mt-4 mb-6 text-yeti-dark-1"
>
  {date.toLocaleDateString("en-US", { month: "long", day: "numeric" })}
</time>
<!-- Add some spacing to all elements generated by markdown -->
<div class="*:mb-4">
  <slot />
</div>
